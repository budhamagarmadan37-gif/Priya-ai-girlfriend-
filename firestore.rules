rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_profiles/{document=**} {
      allow read, write: if true;
    }
    match /chat_messages/{document=**} {
      allow read, write: if true;
    }
    match /user_settings/{document=**} {
      allow read, write: if true;
    }
  }
}
